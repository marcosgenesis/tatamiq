{
  "expo": {
    "name": "App do Sensei Student",
    "slug": "appdosensei-student",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "appdosensei-student",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o App do Sensei use a câmera para confirmar seu check-in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "com.appdosensei.student",
      "infoPlist": {
        "NSCameraUsageDescription": "Permita que o App do Sensei use a câmera para confirmar seu check-in."
      }
    },
    "android": {
      "package": "com.appdosensei.student"
    }
  }
}
